# ==============================================================================
# 扁平命名：terraform-<project>-<env>.tfvars 示例
# ==============================================================================
# 复制为 terraform-lighthouse-dev.tfvars 并填写实际值
# 敏感项：instance_password 建议通过环境变量 TF_VAR_instance_password 注入
# ==============================================================================

env_id            = "dev"
region            = "cn-hongkong"
instance_type     = "ecs.u1-c1m4.xlarge"
instance_password = "CHANGE_ME_AT_LEAST_8_CHARS"
vpc_cidr          = "10.0.0.0/16"
vswitch_cidr      = "10.0.1.0/24"
enable_spot       = true
spot_strategy     = "SpotAsPriceGo"
spot_price_limit  = 0.5
eip_bandwidth     = 100
