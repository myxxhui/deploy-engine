# ==============================================================================
# Titan 开发环境配置（瘦身版 - Phase 1）
# ==============================================================================
# 只包含环境特有的配置
# 所有默认值已下沉到 system-services/titan-stack/values.yaml
# ==============================================================================

# 全局配置
global:
  project_name: "titan-provisioner" # 用于 OSS/VPC 等资源命名，勿随意修改
  imageRegistry: "crpi-7vifw4ok9jkcxr60.cn-hongkong.personal.cr.aliyuncs.com/titan-core"
  security:
    allowInsecureImages: true
  storageClass: "local-path"
  env: "dev1"
  cloud:
    currentProvider: "alibabacloud"
    region: "cn-hangzhou"
  domain:
    base: "titan-core.io"
  platform:
    clusterID: "titan-hub-01"
  # K3s API Server 配置
  k3s:
    apiServer:
      domain: "k3s-titan.yanhui.store" # K3s API Server 域名（用于 TLS SAN）

# 镜像仓库配置
registry:
  server: "crpi-7vifw4ok9jkcxr60.cn-hongkong.personal.cr.aliyuncs.com"
  namespace: "titan-core"
  username: "sean_hui"
  password: "Hui123123"
  image_registry: "crpi-7vifw4ok9jkcxr60.cn-hongkong.personal.cr.aliyuncs.com/titan-core"
  image_pull_secrets: "titan-registry-key"

# 存储配置
storage:
  provider: "local-oss"
  local_oss:
    storage_class: "local-path"
  nas:
    mount_domain: ""
    storage_class: "alicloud-nas-subpath"
  local:
    storage_class: "local-path"

# 组件开关（只保留 enabled 和环境特有参数）

sealed-secrets:
  enabled: true

kyverno:
  enabled: true
  config:
    policies:
      imagePullSecrets:
        enabled: true
        secretName: "titan-registry-key"

apisix:
  enabled: true
  config:
    etcd:
      replica_count: 1 # 开发环境单副本

cert-manager:
  enabled: true

external-dns:
  enabled: true # 开发环境禁用

ddns-go:
  enabled: false # 开发环境禁用

keycloak:
  enabled: true
  config:
    ingress:
      hostname: "keycloak.titan-core.io"

crossplane:
  enabled: true

monitoring:
  enabled: true
